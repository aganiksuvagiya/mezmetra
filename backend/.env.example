# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the API then uses a file-based PGlite database in .data/pglite.
# For Aiven Postgres paste the "Service URI" from the Aiven console (Overview -> Connection information), e.g.
# DATABASE_URL=postgres://avnadmin:<password>@<service>-<project>.aivencloud.com:<port>/defaultdb?sslmode=require
DATABASE_URL=
# Download "CA certificate" from the same Aiven page and point to it so the server certificate is verified.
DATABASE_CA_CERT_PATH=
# Aiven's free plan allows few connections; keep the pool small.
DATABASE_POOL_MAX=5

# --- App --------------------------------------------------------------------------------------------------------
PORT=4000
# Required in production (32+ random characters): signs login tokens and encrypts stored Razorpay secrets.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5180,http://localhost:5174
# Public URL of the customer web app. This is the base of the link inside every table QR code.
CUSTOMER_APP_URL=http://localhost:5174
# Let new restaurants sign up from the admin login page.
ALLOW_SIGNUP=true
# Ways of paying the product offers: upi, cash, razorpay (comma separated). Default is UPI only.
PAYMENT_METHODS=upi
# Accounts (emails, comma separated) that run the platform. They get a "Platform" section in the admin to see every restaurant and
# suspend or reactivate it. Empty = nobody. Sign up an account of your own first, then list its email here.
SUPER_ADMIN_EMAILS=
# Email (password reset). Any SMTP provider works: Gmail with an "app password", Brevo, Resend, Amazon SES ...
# SMTP_URL=smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=MezMitra <no-reply@yourdomain.in>
# Public URL of the admin web app: the base of the link in the password reset email.
ADMIN_APP_URL=http://localhost:5180
# Apply pending SQL migrations at start-up.
AUTO_MIGRATE=true
# Number of reverse proxies / load balancers in front of the API (Render, Fly, Heroku: 1; none: 0 or false).
# "true" is treated as 1. In production the default is 1.
TRUST_PROXY=0
