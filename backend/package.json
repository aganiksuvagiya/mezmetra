{
  "name": "mezmitra-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "db:check": "node --env-file-if-exists=.env src/dbcheck.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "demo:history": "node --env-file-if-exists=.env src/demoHistory.js",
    "demo:prices": "node --env-file-if-exists=.env src/demoPrices.js",
    "demo:qr": "node --env-file-if-exists=.env src/demoQr.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "10.1.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  }
}
